# Copy to .env.local (Next.js dev) and to .dev.vars (Cloudflare preview). Never commit real values.
# The app connects as a login role that is a member of `toptop_app` (not the table owner, no BYPASSRLS).
DATABASE_URL=postgres://toptop_app_login:password@localhost:5432/toptop
# Drizzle Kit migrations run as the table owner. Falls back to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=postgres://owner:password@localhost:5432/toptop
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
